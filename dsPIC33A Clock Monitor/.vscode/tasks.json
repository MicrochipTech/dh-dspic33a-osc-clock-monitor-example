{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "MPLAB-CMake",
			"label": "clock_monitor: default - Build",
			"action": "fullbuild",
			"buildType": "debug",
			"configName": "default",
			"configPath": "${workspaceFolder}/.vscode/clock_monitor.mplab.json",
			"problemMatcher": [
				"$cmakeGenerate",
				"$cmakeBuildCompiler",
				"$cmakeBuildLinker"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		}
	]
}